# Prisma + Auth.js (app data: users, progress, gamification)
DATABASE_URL=postgresql://ova:ova@localhost:5432/ova_app

# Payload CMS (course content: courses, modules, blocks)
PAYLOAD_DATABASE_URL=postgresql://ova:ova@localhost:5432/ova_cms

# Payload CMS — min 32 characters in production
PAYLOAD_SECRET=change-me-in-production-min-32-chars-long

# Auth.js (Agente 3)
AUTH_SECRET=change-me-in-production-min-32-chars-long
NEXTAUTH_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
